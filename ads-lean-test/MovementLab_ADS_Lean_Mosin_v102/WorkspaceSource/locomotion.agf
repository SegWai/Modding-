     WeightSecondaryChain "((clamp(-MLADSLeanAmount, 0.0, 1.0)+clamp(MLADSLeanAmount, 0.0, 1.0)*(1.0-clamp(Stance, 0.0, 1.0)))*MLADSLeanGate*MLADSLeanMoveBlend*MLADSLeanWeaponShift) > 0.001"
     WeaponDirLr "((AimIKX*(1.0-clamp((MLADSLeanCanary-0.8)*5.0, 0.0, 1.0))))*(1.0-clamp(abs(MLADSLeanAmount)*MLADSLeanGate, 0.0, 1.0))"
