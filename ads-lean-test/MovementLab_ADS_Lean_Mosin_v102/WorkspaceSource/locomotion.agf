    AnimSrcNodeQueue LocomotionQ {
     EditorPos 2.9 -18.3
     Child "MeleeBlockQ"
     QueueItems {
      AnimSrcNodeQueueItem "{6930A8DE26988255}" {
       Child "WeaponChangeStanceSTM"
       StartExpr "IsCommand(CMD_Weapon_Hide) || IsCommand(CMD_Weapon_Show)"
       InterruptExpr ""
       StartTime ""
       BlendInTime 0.1
       BlendOutTime 0.35
       InterruptOthers 1
       IsReentrant 0
      }
      AnimSrcNodeQueueItem "{6930A8DE2698826A}" {
       Child "ActionMaster"
       StartExpr "IsCommand(CMD_Action) || IsCommand(CMD_TRAILER_WALK_AWAY) "
       InterruptExpr "GetCommandI(CMD_InternalAction) == -2 || (Raised || MLADSLeanCanary > 0.9)"
       StartTime ""
       BlendInTime 0.2
       BlendOutTime 0.4
       InterruptOthers 1
       IsReentrant 1
      }
      AnimSrcNodeQueueItem "{6930A8DE26988265}" {
       Child "ReloadStanceChange"
       StartExpr "IsCommand(CMD_Reload_Magazine) || IsCommand(CMD_Reload_BoltAction) || IsCommand(CMD_Reload_Chambering) || IsCommand(CMD_Reload_ChamberingFast) || IsCommand(CMD_Weapon_Jam) || IsCommand(CMD_Reload_Clip)"
       InterruptExpr "IsCommand(CMD_Weapon_Interrupt)"\
       "||"\
       "(Stance == 0 && HasVariableChanged(Stance, 2))"\
       "||"\
       "(Stance == 1 && HasVariableChanged(Stance, 2))"\
       "||"\
       "(Stance == 2 && HasVariableChanged(Stance))"
       StartTime ""
       BlendInTime 0.35
       BlendOutTime 0.35
       InterruptOthers 1
       IsReentrant 1
      }
     }
    }
