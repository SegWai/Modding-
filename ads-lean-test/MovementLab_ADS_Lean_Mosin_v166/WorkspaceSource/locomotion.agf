     "ikpose_secchainoffset = LeftHandIKTarget      			// secondary chain ik target offset (relative to weapon)"\
     "ikpose_chainmiddledir = RightForeArmDirection			// hand to elbow direction (from hand)"\
     "ikpose_chainmiddlediro = RightHandOrigin,RightForeArmDirectionOrigin	// original hand to elbow direction (from hand)"\
     "ikpose_secchainmiddledir = LeftForeArmDirection			// sec hand to elbow direction (from ikpose_secchainoffset)"\
     "ikpose_secchainmiddlediro = LeftHandOrigin,LeftForeArmDirectionOrigin	// original sec hand to elbow direction (from ikpose_secchainoffset)"\
     "outputweaponoffsettobuffer = true"\
     ""
     BlendInTime 0.22
     BlendOutTime 0.22
     WeightAim "(((clamp(-MLADSLeanAmount, 0.0, 1.0)+clamp(MLADSLeanAmount, 0.0, 1.0)*(1.0-clamp(Stance, 0.0, 1.0)))*MLADSLeanGate*MLADSLeanMoveBlend*MLADSLeanWeaponShift) > 0.001) && (ML106ShoulderedGrip > 0.5)"
     WeightPrimaryChain "(((clamp(-MLADSLeanAmount, 0.0, 1.0)+clamp(MLADSLeanAmount, 0.0, 1.0)*(1.0-clamp(Stance, 0.0, 1.0)))*MLADSLeanGate*MLADSLeanMoveBlend*MLADSLeanWeaponShift) > 0.001) && (ML106ShoulderedGrip > 0.5)"
     WeightSecondaryChain "(((clamp(-MLADSLeanAmount, 0.0, 1.0)+clamp(MLADSLeanAmount, 0.0, 1.0)*(1.0-clamp(Stance, 0.0, 1.0)))*MLADSLeanGate*MLADSLeanMoveBlend*MLADSLeanWeaponShift) > 0.001) && (ML106ShoulderedGrip > 0.5)"
     WeaponDirLr "((AimIKX*(1.0-clamp((MLADSLeanCanary-0.8)*5.0, 0.0, 1.0))))*(1.0-clamp(abs(MLADSLeanAmount)*MLADSLeanGate, 0.0, 1.0))"
     WeaponDirUd "((AimY*(1.0-clamp((MLADSLeanCanary-0.8)*5.0, 0.0, 1.0))))*(1.0-clamp(abs(MLADSLeanAmount)*MLADSLeanGate, 0.0, 1.0))"
     WeaponRoll "(8.0*clamp(MLADSLeanAmount,-1.0,0.0)+(8.0-7.0*(1.0-clamp(Stance,0.0,1.0))*(1.0-MLADSLeanMoveBlend)*(1.0-clamp(MovementSpeed,0.0,1.0)))*clamp(MLADSLeanAmount,0.0,1.0))*MLADSLeanGate"
    }
