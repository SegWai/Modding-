AnimSrcNodeWeaponIk ML149_BodyWeaponFollow {
     EditorPos 2.7 -10.7
     Child "ML154_BodyGate_RightToeBase"
     IkconfigName "ML149_BodyWeaponConfig"
     Ikconfig "// ik pose anim"\
     "// (root - means RightHand - but right hand is not exported)"\
     "//   |- RightHand_Dummy (where Weapon is)"\
     "//   |                |-  LeftHandIKTarget  (where left hand is on weapon)"\
     "//   |- RightHandOrigin ( inverse transform where hand originally was)"\
     ""\
     "// basic setup - "\
     "// hand - bone which represents hand holding weapon"\
     "// weapon - bone which represents weapon node in hand"\
     "// weaponrotator - bone - around which weapon rotates"\
     "hand = RightHand"\
     "weapon = RightHand_Dummy"\
     "weaponrotator = RightHand"\
     "weaponaxis= -x"\
     ""\
     "chain = RightArm, RightArmRoll, RightForeArm, RightForeArmRoll, RightHand"\
     "chainaxis=-x"\
     "secchain = LeftArm, LeftArmRoll, LeftForeArm, LeftForeArmRoll, LeftHand"\
     "secchainaxis=+x"\
     ""\
     "ikpose_chainoffset = RightHandOrigin              			// bone in ikpose specifying where was "\
     "ikpose_weaponoffset = RightHand_Dummy      			// weapon offset from RHand "\
     "ikpose_secchainoffset = LeftHandIKTarget      			// secondary chain ik target offset (relative to weapon)"\
     "ikpose_chainmiddledir = RightForeArmDirection			// hand to elbow direction (from hand)"\
     "ikpose_chainmiddlediro = RightHandOrigin,RightForeArmDirectionOrigin	// original hand to elbow direction (from hand)"\
     "ikpose_secchainmiddledir = LeftForeArmDirection			// sec hand to elbow direction (from ikpose_secchainoffset)"\
     "ikpose_secchainmiddlediro = LeftHandOrigin,LeftForeArmDirectionOrigin	// original sec hand to elbow direction (from ikpose_secchainoffset)"\
     "outputweaponoffsettobuffer = true"\
     ""
     BlendInTime 0
     BlendOutTime 0
     WeightAim "true"
     WeightPrimaryChain "false"
     WeightSecondaryChain "false"
     WeaponDirLr "ML147LeftMuzzleYaw*clamp(-MLADSLeanAmount,0.0,1.0)+ML147RightMuzzleYaw*clamp(MLADSLeanAmount,0.0,1.0)"
     WeaponDirUd "ML147LeftMuzzlePitch*clamp(-MLADSLeanAmount,0.0,1.0)+ML147RightMuzzlePitch*clamp(MLADSLeanAmount,0.0,1.0)"
     WeaponRoll "(8.0*clamp(MLADSLeanAmount,-1.0,0.0)+(8.0-7.0*(1.0-clamp(Stance,0.0,1.0))*(1.0-MLADSLeanMoveBlend)*(1.0-clamp(MovementSpeed,0.0,1.0)))*clamp(MLADSLeanAmount,0.0,1.0))*MLADSLeanGate"
    }
    AnimSrcNodeBlend ML149_BodyWithWeapon {
     BlendWeight "ML149WeaponFollow"
     Child0 "ML154_BodyGate_RightToeBase"
     Child1 "ML149_BodyWeaponFollow"
     OptimizeMin 1
     OptimizeMax 1
    }
AnimSrcNodeWeaponIk ML147_RightMuzzleIK {
     EditorPos 2.7 -10.7
     Child "ML139_PublishRightStraight"
     IkconfigName "ML147_RightMuzzleConfig"
     Ikconfig "// ik pose anim"\
     "// (root - means RightHand - but right hand is not exported)"\
     "//   |- RightHand_Dummy (where Weapon is)"\
     "//   |                |-  LeftHandIKTarget  (where left hand is on weapon)"\
     "//   |- RightHandOrigin ( inverse transform where hand originally was)"\
     ""\
     "// basic setup - "\
     "// hand - bone which represents hand holding weapon"\
     "// weapon - bone which represents weapon node in hand"\
     "// weaponrotator - bone - around which weapon rotates"\
     "hand = RightHand"\
     "weapon = RightHand_Dummy"\
     "weaponrotator = RightHand"\
     "weaponaxis= -x"\
     ""\
     "chain = RightArm, RightArmRoll, RightForeArm, RightForeArmRoll, RightHand"\
     "chainaxis=-x"\
     "secchain = LeftArm, LeftArmRoll, LeftForeArm, LeftForeArmRoll, LeftHand"\
     "secchainaxis=+x"\
     ""\
     "ikpose_chainoffset = RightHandOrigin              			// bone in ikpose specifying where was "\
     "ikpose_weaponoffset = RightHand_Dummy      			// weapon offset from RHand "\
     "ikpose_secchainoffset = LeftHandIKTarget      			// secondary chain ik target offset (relative to weapon)"\
     "ikpose_chainmiddledir = RightForeArmDirection			// hand to elbow direction (from hand)"\
     "ikpose_chainmiddlediro = RightHandOrigin,RightForeArmDirectionOrigin	// original hand to elbow direction (from hand)"\
     "ikpose_secchainmiddledir = LeftForeArmDirection			// sec hand to elbow direction (from ikpose_secchainoffset)"\
     "ikpose_secchainmiddlediro = LeftHandOrigin,LeftForeArmDirectionOrigin	// original sec hand to elbow direction (from ikpose_secchainoffset)"\
     "outputweaponoffsettobuffer = true"\
     ""
     BlendInTime 0
     BlendOutTime 0
     WeightAim "true"
     WeightPrimaryChain "false"
     WeightSecondaryChain "true"
     WeaponDirLr "(ML147RightMuzzleYaw)*(clamp(MLADSLeanAmount,0.0,1.0)*MLADSLeanGate*(1.0-clamp(Stance,0.0,1.0))*(1.0-MLADSLeanMoveBlend)*(1.0-clamp(MovementSpeed,0.0,1.0))*ML93ArmDrop*ML106ShoulderedGrip*(1.0-ML87FirstPersonCrouchLean))"
     WeaponDirUd "(ML147RightMuzzlePitch)*(clamp(MLADSLeanAmount,0.0,1.0)*MLADSLeanGate*(1.0-clamp(Stance,0.0,1.0))*(1.0-MLADSLeanMoveBlend)*(1.0-clamp(MovementSpeed,0.0,1.0))*ML93ArmDrop*ML106ShoulderedGrip*(1.0-ML87FirstPersonCrouchLean))"
     WeaponRoll "(8.0*clamp(MLADSLeanAmount,-1.0,0.0)+(8.0-7.0*(1.0-clamp(Stance,0.0,1.0))*(1.0-MLADSLeanMoveBlend)*(1.0-clamp(MovementSpeed,0.0,1.0)))*clamp(MLADSLeanAmount,0.0,1.0))*MLADSLeanGate"
    }
    AnimSrcNodeBlend ML147_RightMuzzleOnly {
     BlendWeight "clamp((abs(ML147RightMuzzleYaw)+abs(ML147RightMuzzlePitch))*1000.0,0.0,1.0)"
     Child0 "ML139_PublishRightStraight"
     Child1 "ML147_RightMuzzleIK"
     OptimizeMin 1
     OptimizeMax 1
    }
