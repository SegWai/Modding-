    AnimSrcNodeStateMachine PneMovementSTM {
     EditorPos -26.6 60.5
     states {
      AnimSrcNodeState Run {
       EditorPos -26.2 61.7
       Child "PneRunCyclic"
       StartCondition "MovementSpeed < 3"\
       "||"\
       "("\
       "MovementSpeed == 3 "\
       "&&"\
       "(MovementDirection < -45 || MovementDirection > 45)"\
       ")"\
       "||"\
       "Injured >= 0.5"
       TimeStorage "Normalized Time"
       IsExit 0
      }
      AnimSrcNodeState Sprint {
       EditorPos -23.5 61.7
       Child "PneSprintCyclic"
       StartCondition "MovementSpeed == 3"\
       "&&"\
       "MovementDirection >= -45 && MovementDirection < 45"\
       "&&"\
       "Injured < 0.5"
       TimeStorage "Normalized Time"
       IsExit 0
      }
     }
     transitions {
      AnimSrcNodeTransition "{6930A8DE26988176}" {
       FromState "Sprint"
       ToState "Run"
       Duration "0.5"
       StartTime "GetLowerTime()"
       Condition "MovementSpeed < 3"\
       "||"\
       "(MovementDirection < -45 || MovementDirection > 45 )"\
       "||"\
       "Injured >= 0.5"
       BlendFn S
       PostEval 1
       MotionVecBlend 0x33 0
      }
      AnimSrcNodeTransition "{6930A8DE26988171}" {
       FromState "Run"
       ToState "Sprint"
       Duration "0.5"
       StartTime "GetLowerTime()"
       Condition "MovementSpeed == 3"\
       "&&"\
       "MovementDirection >= -45"\
       "&&"\
       "MovementDirection <= 45 "\
       "&&"\
       "Injured < 0.5"
       BlendFn S
       PostEval 1
       MotionVecBlend 0x33 0
      }
     }
    }
